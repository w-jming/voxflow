#!/bin/sh
set -eu

HOST="${VOXFLOW_HOST:-127.0.0.1}"
PORT="${VOXFLOW_PORT:-8765}"
URL="http://${HOST}:${PORT}"
VOXFLOW_HOME="${VOXFLOW_HOME:-$HOME/.voxflow}"
LOG_DIR="$VOXFLOW_HOME/logs"
RUN_DIR="$VOXFLOW_HOME/run"
PID_FILE="$RUN_DIR/gui.pid"
LOG_FILE="$LOG_DIR/gui.log"
DAEMON_PID_FILE="$RUN_DIR/daemon.pid"
DAEMON_LOG_FILE="$LOG_DIR/daemon.log"
TRAY_PID_FILE="$RUN_DIR/tray.pid"
TRAY_LOG_FILE="$LOG_DIR/tray.log"
PYTHON="/opt/voxflow/venv/bin/python"

export VOXFLOW_HOME
mkdir -p "$LOG_DIR" "$RUN_DIR"

if [ -f "$DAEMON_PID_FILE" ] && kill -0 "$(cat "$DAEMON_PID_FILE")" 2>/dev/null; then
  :
else
  PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 nohup "$PYTHON" -m voxflow daemon >"$DAEMON_LOG_FILE" 2>&1 &
  echo "$!" >"$DAEMON_PID_FILE"
fi

if [ -z "${VOXFLOW_NO_TRAY:-}" ]; then
  if [ -f "$TRAY_PID_FILE" ] && kill -0 "$(cat "$TRAY_PID_FILE")" 2>/dev/null; then
    :
  else
    nohup voxflow-tray >"$TRAY_LOG_FILE" 2>&1 &
    echo "$!" >"$TRAY_PID_FILE"
  fi
fi

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  :
else
  PYTHONNOUSERSITE=1 nohup "$PYTHON" -m voxflow gui --host "$HOST" --port "$PORT" >"$LOG_FILE" 2>&1 &
  echo "$!" >"$PID_FILE"
  sleep 1
fi

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$URL" >/dev/null 2>&1 || printf '%s\n' "$URL"
else
  printf '%s\n' "$URL"
fi
