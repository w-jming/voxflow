[Unit]
Description=Local Speak Input background voice input daemon
Documentation=file:/usr/share/doc/local-speak-input/README.md.gz
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/local-speak-daemon
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
